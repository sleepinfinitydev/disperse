{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Disperse Helm Chart Values",
  "type": "object",
  "definitions": {
    "imageSpec": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "serviceSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "nodePort": { "type": ["integer", "null"] },
        "annotations": { "type": "object" }
      }
    },
    "ingressSpec": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "httpRouteSpec": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "https": { "type": "boolean" },
        "annotations": { "type": "object" },
        "labels": { "type": "object" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array" },
        "rules": { "type": "array" }
      }
    },
    "sidecarSpec": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["local", "remote", "disabled"]
        },
        "image": { "$ref": "#/definitions/imageSpec" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "env": { "type": "array" },
        "resources": { "type": "object" }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": { "type": "array" }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": { "$ref": "#/definitions/imageSpec" },
    "imagePullSecrets": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "disperse": {
      "type": "object",
      "properties": {
        "krokiBaseUrl": { "type": "string" },
        "krokiRemoteUrl": { "type": "string" },
        "engineModes": { "type": "object" },
        "footerCredits": { "type": ["string", "null"] },
        "disabledEngines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": { "type": "array" }
      }
    },
    "service": { "$ref": "#/definitions/serviceSpec" },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "kroki": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "remoteFallbackUrl": { "type": "string" },
        "image": { "$ref": "#/definitions/imageSpec" },
        "service": { "$ref": "#/definitions/serviceSpec" },
        "safeMode": {
          "type": "string",
          "enum": ["UNSAFE", "SAFE", "SECURE"]
        },
        "maxUriLength": { "type": "integer", "minimum": 1024 },
        "env": { "type": "array" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "sidecars": {
          "type": "object",
          "properties": {
            "shmSize": { "type": "string" },
            "mermaid": { "$ref": "#/definitions/sidecarSpec" },
            "bpmn": { "$ref": "#/definitions/sidecarSpec" },
            "excalidraw": { "$ref": "#/definitions/sidecarSpec" }
          }
        },
        "ingress": { "$ref": "#/definitions/ingressSpec" },
        "httpRoute": { "$ref": "#/definitions/httpRouteSpec" }
      }
    },
    "ingress": { "$ref": "#/definitions/ingressSpec" },
    "httpRoute": { "$ref": "#/definitions/httpRouteSpec" },
    "test": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/definitions/imageSpec" }
      }
    },
    "extraManifests": {
      "type": "array"
    }
  }
}
